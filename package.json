{
  "name": "phone-screencast",
  "version": "1.0.0",
  "description": "Cast your phone screen to computer via USB",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "screencast",
    "phone",
    "android",
    "adb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@devicefarmer/adbkit": "^3.2.6"
  },
  "build": {
    "appId": "com.phonescreen.cast",
    "productName": "Phone Screencast",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
